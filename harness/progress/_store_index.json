{"text": "<!-- Layout: a board you leave open. Status line, three tiles for the gauntlet\n     state, then the per-piece table that is the real content, then every\n     metric with its provenance, then the log. Nothing animates. -->\n<style>\n  .gd { font-family: var(--font-anthropic-sans); }\n  .gd-head { display: flex; flex-direction: column; gap: var(--cds-gap-xs); margin-bottom: var(--cds-gap-lg); }\n  .gd-title { font-family: var(--font-anthropic-serif); font-weight: 400;\n              font-size: var(--cds-font-size-title); margin: 0; }\n  .gd-take { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); margin: 0; max-width: 60ch; }\n\n  .gd-status { display: flex; align-items: flex-start; gap: var(--cds-gap-sm);\n               background: var(--color-panel); border: 1px solid var(--color-border-line);\n               border-radius: var(--cds-radius); padding: var(--cds-pad-md);\n               margin-bottom: var(--cds-gap-lg); font-size: var(--cds-font-size-body); }\n  .gd-dot { width: .5rem; height: .5rem; border-radius: 50%; flex: none; margin-top: .45em;\n            background: var(--color-warn); }\n\n  .gd-tiles { display: grid; gap: var(--cds-gap-md); margin-bottom: var(--cds-gap-xl);\n              grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }\n  .gd-tile { background: var(--color-panel); border: 1px solid var(--color-border-line);\n             border-radius: var(--cds-radius); padding: var(--cds-pad-lg);\n             display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n  .gd-tile-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .gd-tile-num { font-family: var(--font-anthropic-serif); font-weight: 400;\n                 font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums;\n                 line-height: 1.1; }\n  .gd-tile-of { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); }\n  .gd-tile-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n\n  .gd-sec { margin-bottom: var(--cds-gap-xl); }\n  .gd-sec-h { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium);\n              margin: 0 0 var(--cds-gap-xs); }\n  .gd-sec-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption);\n                 margin: 0 0 var(--cds-gap-md); max-width: 72ch; }\n\n  .gd-card { background: var(--color-panel); border: 1px solid var(--color-border-line);\n             border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .gd-scroll { overflow-x: auto; }\n  .gd table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); }\n  .gd th { text-align: left; font-weight: var(--cds-font-weight-medium);\n           color: var(--color-fg-muted); padding: 0 var(--cds-pad-sm) var(--cds-pad-xs) 0;\n           border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .gd td { padding: var(--cds-pad-xs) var(--cds-pad-sm) var(--cds-pad-xs) 0;\n           border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n  .gd td.gd-num { font-variant-numeric: tabular-nums; text-align: right; padding-right: var(--cds-pad-md); }\n  .gd tr:last-child td { border-bottom: 0; }\n  .gd-piece { font-weight: var(--cds-font-weight-medium); color: var(--color-fg); white-space: nowrap; }\n  .gd-wrap { min-width: 22ch; }\n\n  .gd-pill { display: inline-block; padding: .1em .5em; border-radius: var(--cds-radius);\n             border: 1px solid var(--color-border-line); font-size: var(--cds-font-size-caption);\n             white-space: nowrap; }\n  .gd-pill-wait { color: var(--color-fg-muted); }\n  .gd-pill-run  { color: var(--color-warn); border-color: var(--color-warn); }\n  .gd-pill-done { color: var(--color-ok); border-color: var(--color-ok); }\n  .gd-pill-bad  { color: var(--color-bad); border-color: var(--color-bad); }\n\n  .gd-prov { color: var(--color-fg-muted); }\n  .gd-none { color: var(--color-fg-muted); }\n  .gd-log { display: flex; flex-direction: column; gap: var(--cds-gap-md); }\n  .gd-log-row { display: grid; grid-template-columns: 7rem 1fr; gap: var(--cds-gap-md); }\n  .gd-log-at { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption);\n               font-variant-numeric: tabular-nums; }\n  .gd-log-ev { font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption);\n               margin-bottom: .2em; }\n  .gd-log-de { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); max-width: 72ch; }\n  @media (max-width: 30rem) { .gd-log-row { grid-template-columns: 1fr; gap: var(--cds-gap-xs); } }\n</style>\n\n<div class=\"gd\">\n  <div class=\"gd-head\">\n    <h1 class=\"gd-title\">GridDown gauntlet</h1>\n    <p class=\"gd-take\" id=\"gd-takeaway\">&mdash;</p>\n  </div>\n\n  <div class=\"gd-status\">\n    <span class=\"gd-dot\" id=\"gd-status-dot\"></span>\n    <span id=\"gd-status-text\">&mdash;</span>\n  </div>\n\n  <div class=\"gd-tiles\">\n    <div class=\"gd-tile\">\n      <span class=\"gd-tile-label\">Pieces won blind against Bridgefy</span>\n      <span>\n        <span class=\"gd-tile-num\" data-source=\"gauntlet\" data-field=\"won\" data-row=\"0\">&mdash;</span>\n        <span class=\"gd-tile-of\">of <span data-source=\"gauntlet\" data-field=\"judged\" data-row=\"0\">&mdash;</span></span>\n      </span>\n      <span class=\"gd-tile-note\">A critic must pick ours with the labels stripped. Nothing counts until it does.</span>\n    </div>\n    <div class=\"gd-tile\">\n      <span class=\"gd-tile-label\">Published findings reproduced</span>\n      <span>\n        <span class=\"gd-tile-num\" data-source=\"metrics\" data-field=\"ours\"\n              data-where=\"metric=Published%20Bridgefy%20findings%20reproduced\">&mdash;</span>\n        <span class=\"gd-tile-of\">of 14</span>\n      </span>\n      <span class=\"gd-tile-note\">Target is zero. 14 findings across the 2020 and 2022 papers; ten hard rules derived from them.</span>\n    </div>\n    <div class=\"gd-tile\">\n      <span class=\"gd-tile-label\">Builders reporting complete</span>\n      <span>\n        <span class=\"gd-tile-num\" data-source=\"gauntlet\" data-field=\"builders_done\" data-row=\"0\">&mdash;</span>\n        <span class=\"gd-tile-of\">of <span data-source=\"gauntlet\" data-field=\"builders_total\" data-row=\"0\">&mdash;</span></span>\n      </span>\n      <span class=\"gd-tile-note\">Seven judged pieces, plus the simulator and the baselines that make judging possible.</span>\n    </div>\n  </div>\n\n  <div class=\"gd-sec\">\n    <h2 class=\"gd-sec-h\">The pieces</h2>\n    <p class=\"gd-sec-note\">Each piece is built and judged on its own. A critic exercises the build, puts it\n      beside Bridgefy with the labels stripped, says which is better and names the single biggest remaining\n      gap, then hands it back. The loop runs until the critic picks ours.</p>\n    <div class=\"gd-card gd-scroll\">\n      <table data-source=\"pieces\" data-row-key=\"piece\">\n        <thead><tr>\n          <th data-field=\"piece\">Piece</th>\n          <th data-field=\"crate\">Owns</th>\n          <th data-field=\"builder\">Builder</th>\n          <th data-field=\"critic\">Critic</th>\n          <th data-field=\"lines\">Lines</th>\n          <th data-field=\"tests_written\">Tests</th>\n          <th data-field=\"rounds\">Rounds</th>\n          <th data-field=\"blind_verdict\">Blind verdict</th>\n          <th data-field=\"biggest_gap\">Biggest remaining gap</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </div>\n\n  <div class=\"gd-sec\">\n    <h2 class=\"gd-sec-h\">Every number, and where it came from</h2>\n    <p class=\"gd-sec-note\">Per-hop distance in a built-up area and end-to-end delivery across three or more\n      hops are the two the project is graded on. A blank is a number nobody has produced yet, not a zero.\n      Nothing here is a field measurement until it says so: this machine has no radios and no phones, so\n      hardware numbers come from the field rounds and everything else is modelled.</p>\n    <div class=\"gd-card gd-scroll\">\n      <table data-source=\"metrics\" data-row-key=\"metric\">\n        <thead><tr>\n          <th data-field=\"metric\">Metric</th>\n          <th data-field=\"unit\">Unit</th>\n          <th data-field=\"target\">Target</th>\n          <th data-field=\"ours\">Ours</th>\n          <th data-field=\"bridgefy\">Bridgefy</th>\n          <th data-field=\"provenance\">Provenance</th>\n          <th data-field=\"note\">Note</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </div>\n\n  <div class=\"gd-sec\">\n    <h2 class=\"gd-sec-h\">Log</h2>\n    <div class=\"gd-card\">\n      <div class=\"gd-log\" data-source=\"timeline\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var PILL = [\n    [/^done$/i,                      'gd-pill-done'],\n    [/^(building|running|in progress)/i, 'gd-pill-run'],\n    [/^(blocked|not yet|waiting)/i,  'gd-pill-wait'],\n    [/^(failed|lost|theirs)/i,       'gd-pill-bad'],\n    [/^ours$/i,                      'gd-pill-done'],\n    [/^n\\/a$/i,                      'gd-pill-wait']\n  ];\n  function pillClass(v) {\n    for (var i = 0; i < PILL.length; i++) if (PILL[i][0].test(v)) return PILL[i][1];\n    return 'gd-pill-wait';\n  }\n  function pill(td, v) {\n    var s = document.createElement('span');\n    s.className = 'gd-pill ' + pillClass(v);\n    s.textContent = v;\n    td.appendChild(s);\n  }\n  function plain(td, v, cls) {\n    if (cls) td.className = cls;\n    td.textContent = (v === null || v === undefined || v === '') ? '\u2014' : String(v);\n  }\n\n  dash.calc('gauntlet', {\n    title: 'Gauntlet state',\n    description: 'Counts the pieces whose blind verdict picked ours, and the builders reporting complete, from the pieces table.',\n    inputs: ['pieces'],\n    fn: function (pieces) {\n      var judged = 0, won = 0, done = 0;\n      for (var i = 0; i < pieces.length; i++) {\n        var p = pieces[i];\n        if (p.kind === 'judged') {\n          judged++;\n          if (String(p.blind_verdict).toLowerCase() === 'ours') won++;\n        }\n        if (p.kind !== 'frozen contract' && String(p.builder).toLowerCase() === 'done') done++;\n      }\n      return [{won: won, judged: judged, builders_done: done, builders_total: 9}];\n    }\n  });\n\n  function skel(on) {\n    ['gd-takeaway', 'gd-status-text'].forEach(function (id) {\n      document.getElementById(id).classList.toggle('dash-skeleton', on);\n    });\n  }\n\n  dash.onData(function () {\n    var P = dash.data('pieces'), M = dash.data('metrics'), T = dash.data('timeline');\n\n    skel(P.status === 'loading');\n\n    // Status line: say what is actually blocking, in one sentence.\n    var dot = document.getElementById('gd-status-dot');\n    var txt = document.getElementById('gd-status-text');\n    var take = document.getElementById('gd-takeaway');\n\n    if (P.status === 'ok') {\n      var rows = P.data || [];\n      var building = rows.filter(function (r) { return /^(building|resumed)/i.test(r.builder); }).length;\n      var blocked  = rows.filter(function (r) { return /^blocked/i.test(r.critic); }).length;\n      var judged   = rows.filter(function (r) { return r.kind === 'judged'; }).length;\n      var won      = rows.filter(function (r) { return String(r.blind_verdict).toLowerCase() === 'ours'; }).length;\n\n      if (won >= judged && judged > 0) {\n        dot.style.background = 'var(--color-ok)';\n        txt.textContent = 'Every piece has been picked over Bridgefy blind. The loop is finished.';\n      } else if (blocked > 0) {\n        dot.style.background = 'var(--color-warn)';\n        var paused = rows.filter(function (r) { return /^paused/i.test(r.builder); }).length;\n        var written = rows.reduce(function (a, r) { return a + (r.tests_written || 0); }, 0);\n        var passing = rows.reduce(function (a, r) { return a + (r.tests_passing || 0); }, 0);\n        txt.textContent = building + ' builders running, ' + paused +\n          ' paused to stay inside the account budget, and ' + blocked +\n          ' critics held back until the blind rig exists. Of ' + written +\n          ' test functions written so far, ' + passing +\n          ' have actually compiled and run \\u2014 the rest are in modules that were never wired in.';\n      } else {\n        dot.style.background = 'var(--color-warn)';\n        txt.textContent = won + ' of ' + judged + ' pieces have been picked over Bridgefy blind. ' +\n          'The rest are still in the loop.';\n      }\n      take.textContent = 'An off-grid messenger over phone-to-phone Bluetooth and infrastructure-free ' +\n        'Wi-Fi, carried across a city by hop count and by people walking. Built piece by piece, each one ' +\n        'judged blind against the real Bridgefy protocol and against bitchat, which is the harder opponent.';\n    } else if (P.status === 'error' || P.status === 'connect') {\n      dot.style.background = 'var(--color-bad)';\n      txt.textContent = 'Failed to load';\n      take.textContent = '\u2014';\n    }\n\n    // Pieces\n    var pb = document.querySelector('table[data-source=\"pieces\"] tbody');\n    pb.textContent = '';\n    if (P.status === 'ok') {\n      (P.data || []).forEach(function (r) {\n        var tr = pb.insertRow();\n        plain(tr.insertCell(), r.piece, 'gd-piece');\n        plain(tr.insertCell(), r.crate, 'gd-prov');\n        pill(tr.insertCell(), String(r.builder));\n        pill(tr.insertCell(), String(r.critic));\n        plain(tr.insertCell(), r.lines, 'gd-num');\n        var tc = tr.insertCell();\n        tc.className = 'gd-num';\n        // A test that has never been compiled is not a passing test. Show both\n        // numbers so the gap between written and running is impossible to miss.\n        if (r.tests_written > 0 && r.tests_passing === 0) {\n          tc.textContent = '0 / ' + r.tests_written;\n          tc.title = r.tests_written + ' written, none compiled yet';\n        } else if (r.tests_written > 0) {\n          tc.textContent = String(r.tests_passing);\n        } else {\n          tc.textContent = '\\u2014';\n        }\n        plain(tr.insertCell(), r.rounds, 'gd-num');\n        pill(tr.insertCell(), String(r.blind_verdict));\n        plain(tr.insertCell(), r.biggest_gap, 'gd-wrap');\n      });\n    }\n\n    // Metrics\n    var mb = document.querySelector('table[data-source=\"metrics\"] tbody');\n    mb.textContent = '';\n    if (M.status === 'ok') {\n      (M.data || []).forEach(function (r) {\n        var tr = mb.insertRow();\n        plain(tr.insertCell(), r.metric, 'gd-piece');\n        plain(tr.insertCell(), r.unit, 'gd-prov');\n        plain(tr.insertCell(), r.target, 'gd-prov');\n        plain(tr.insertCell(), r.ours, 'gd-num');\n        plain(tr.insertCell(), r.bridgefy, 'gd-num');\n        plain(tr.insertCell(), r.provenance, 'gd-prov');\n        plain(tr.insertCell(), r.note, 'gd-wrap');\n      });\n    }\n\n    // Log\n    var lg = document.querySelector('.gd-log');\n    lg.textContent = '';\n    if (T.status === 'ok') {\n      (T.data || []).slice().reverse().forEach(function (r) {\n        var row = document.createElement('div'); row.className = 'gd-log-row';\n        var at = document.createElement('div'); at.className = 'gd-log-at';\n        at.textContent = String(r.at); row.appendChild(at);\n        var body = document.createElement('div');\n        var ev = document.createElement('div'); ev.className = 'gd-log-ev';\n        ev.textContent = String(r.event); body.appendChild(ev);\n        var de = document.createElement('div'); de.className = 'gd-log-de';\n        de.textContent = String(r.detail); body.appendChild(de);\n        row.appendChild(body); lg.appendChild(row);\n      });\n    }\n  });\n})();\n</script>\n"}